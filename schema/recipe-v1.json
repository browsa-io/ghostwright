{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browsa.io/schemas/recipe-v1.json",
  "title": "Browsa replay recipe v1",
  "type": "object",
  "required": ["name", "version", "params", "output", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "version": { "type": "integer", "minimum": 1 },
    "params": { "$ref": "#/$defs/jsonSchema" },
    "output": { "$ref": "#/$defs/jsonSchema" },
    "start_url": { "type": "string", "format": "uri" },
    "exit": { "$ref": "#/$defs/exit" },
    "exits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "exits tried in order when a run is blocked or rate-limited (after fresh addresses on the same exit); when absent, [exit]",
      "items": { "$ref": "#/$defs/exit" }
    },
    "alternates": {
      "type": "array",
      "maxItems": 3,
      "description": "other sources for the same output (an official API, a mirror), run in order when every exit was blocked",
      "items": {
        "type": "object",
        "required": ["steps"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 80 },
          "start_url": { "type": "string", "format": "uri" },
          "exit": { "$ref": "#/$defs/exit" },
          "steps": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/step" } },
          "fallbacks": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["after", "expr"],
              "additionalProperties": false,
              "properties": { "after": { "type": "string" }, "expr": { "type": "string", "maxLength": 500 } }
            }
          }
        }
      }
    },
    "pacing": {
      "enum": ["human", "fast"],
      "description": "human (default): randomised dwell, reading pauses, typing at human speed; fast: none. The site's request rate applies to both"
    },
    "fallback": {
      "enum": ["none", "agent"],
      "description": "\"agent\": when the replay ends site_changed, invalid_output or blocked, the job runs once as an agent task (costs that task's credits)"
    },
    "steps": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/step" } },
    "fallbacks": {
      "type": "object",
      "description": "step id -> ordered step ids run instead when that step fails (layer 1 -> layer 2)",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["after", "expr"],
        "additionalProperties": false,
        "properties": { "after": { "type": "string" }, "expr": { "type": "string", "maxLength": 500 } }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["auto", "review", "off"] },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "meta": { "type": "object" }
  },
  "$defs": {
    "jsonSchema": { "type": "object", "description": "A JSON Schema for the params or the output." },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": { "enum": ["auto", "datacenter", "residential", "default"] },
        "country": { "type": "string", "pattern": "^[a-z]{2}$" }
      }
    },
    "target": {
      "type": "object",
      "description": "Several locators for one element, tried in order: role+name, css, text, xpath, near.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "name": { "type": "string" },
        "css": { "type": "string" },
        "text": { "type": "string" },
        "xpath": { "type": "string" },
        "near": { "type": "string", "description": "visible text close to the element" },
        "within": { "type": "string", "description": "the text of the element's own item (its card, its row), kept when other controls on the page are named alike; read by local replays, left out of a recipe pushed to Browsa" },
        "frame": { "type": "string", "description": "url substring of the iframe the element lives in" }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
        "kind": { "enum": ["navigate", "click", "type", "select", "press", "scroll", "wait", "fetch", "extract", "assert", "analyze"] },
        "url": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "text": { "type": "string" },
        "value": { "type": "string", "description": "select: the option; scroll: \"down\" | \"up\" (with pages) or pixels" },
        "pages": { "type": "number", "minimum": 0.1, "maximum": 50, "description": "scroll: viewport heights to scroll (default 1)" },
        "keys": { "type": "string" },
        "submit": { "type": "boolean" },
        "for": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "text": { "type": "string" }, "url": { "type": "string" }, "target": { "$ref": "#/$defs/target" } }
        },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "in_page": { "const": true, "description": "fetch always runs inside the page with credentials: include" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": {},
        "mutation": { "type": "boolean", "description": "true for writes (add to cart, submit); never re-sent by tests or bench" },
        "optional": { "type": "boolean", "description": "a failure of this step (more of the same data, a second page) is noted in the trace and the run goes on" },
        "save_as": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" },
        "each": { "type": "string", "description": "fetch: a jsonpath over saved values; the fetch runs once per match (at most 100, in parallel in the page) and saves the list" },
        "as": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$", "description": "fetch with each: the placeholder name of the current match (default item)" },
        "from": { "enum": ["page", "page_json", "saved"] },
        "source": { "type": "string", "description": "saved fetch name, or page JSON selector like script#__NEXT_DATA__" },
        "how": {
          "type": "object",
          "description": "jsonpath for JSON sources, or css/fields for DOM; or model:true for a model-based extract (costs credits)",
          "properties": {
            "jsonpath": { "type": "string" },
            "css": { "type": "string" },
            "fields": { "type": "object", "additionalProperties": { "type": "string" } },
            "model": { "type": "boolean" },
            "into": { "type": "string", "description": "output property that receives the extracted value (default: the output's first array property for a list)" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "keep at most this many items" },
            "allow_empty": { "type": "boolean", "description": "an empty result is not a failure (default false: empty runs the fallbacks)" }
          }
        },
        "schema_ref": { "const": "output" },
        "expr": { "type": "string", "maxLength": 500 },
        "goal": { "type": "string", "maxLength": 500, "description": "plain-language intent of the step, used by one-step repair" },
        "prompt": { "type": "string", "maxLength": 4000, "description": "analyze: the instructions for the model (may use {{param}})" },
        "input": { "type": "array", "maxItems": 20, "items": { "type": "string" }, "description": "analyze: saved names and/or \"output\" sent to the model as JSON (default [output])" },
        "max_input_chars": { "type": "integer", "minimum": 1000, "maximum": 400000, "description": "analyze: the input is cut to this many characters with a note (default 60000)" },
        "output_schema": { "$ref": "#/$defs/jsonSchema" },
        "model": { "type": "string", "maxLength": 120, "description": "analyze: browsa (default, the hosted chain) or provider:model" },
        "into": { "type": "string", "description": "analyze: output property that receives the answer (default: merged into the output)" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "navigate" } } }, "then": { "required": ["url"] } },
        { "if": { "properties": { "kind": { "enum": ["click", "select"] } } }, "then": { "required": ["target"] } },
        { "if": { "properties": { "kind": { "const": "type" } } }, "then": { "required": ["target", "text"] } },
        { "if": { "properties": { "kind": { "const": "fetch" } } }, "then": { "required": ["url", "method", "in_page"] } },
        { "if": { "properties": { "kind": { "const": "extract" } } }, "then": { "required": ["from", "how"] } },
        { "if": { "properties": { "kind": { "const": "analyze" } } }, "then": { "required": ["prompt", "output_schema"] } }
      ]
    }
  }
}
