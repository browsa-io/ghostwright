{
  "name": "ghostwright",
  "version": "0.2.0",
  "description": "Browser agents you run more than once. Record a flow once with any model; replays check every step and need no model when the flow's extracts compile to page reads.",
  "license": "MIT",
  "author": "Browsa <support@browsa.io>",
  "homepage": "https://github.com/browsa-io/ghostwright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/browsa-io/ghostwright.git"
  },
  "bugs": {
    "url": "https://github.com/browsa-io/ghostwright/issues"
  },
  "keywords": [
    "browser-automation",
    "ai-agents",
    "web-agent",
    "replay",
    "playwright",
    "cdp",
    "scraping",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ghostwright": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p . && cp src/engine/pageview.js src/engine/locate.js dist/engine/ && cp cjs/index.cjs cjs/index.d.cts dist/ && chmod +x dist/cli.js",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:smoke": "GHOSTWRIGHT_SMOKE=1 vitest run test/smoke",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "npm run build",
    "test:all": "npm test && npm run test:e2e",
    "docs": "tsx scripts/api-docs.mts",
    "docs:check": "tsx scripts/api-docs.mts --check",
    "pack:check": "node scripts/pack-check.mjs",
    "bench": "node bench/suite/harness/run.mjs --adapter ghostwright-local",
    "bench:report": "node bench/suite/harness/report.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/openai": "^4.0.121",
    "@ai-sdk/openai-compatible": "^3.0.93",
    "ai": "^7.0.177",
    "playwright-core": "~1.65.1"
  },
  "peerDependencies": {
    "browsa": ">=0.4.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "browsa": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
